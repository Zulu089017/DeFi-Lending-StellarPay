# ────── Node / JS / TS ──────
node_modules/
dist/
build/
.next/
.turbo/
out/
coverage/
*.tsbuildinfo
.pnpm-store/

# Lockfile policy: commit every lockfile. Never delete a lockfile to make a
# build pass — regenerate it instead.
#   pnpm-lock.yaml                 pnpm workspace (root + all workspace packages)
#   contracts/package-lock.json    npm project for the EVM contracts (CI: npm ci)
#   package-lock.json,             npm mirrors of the root / packages/sdk /
#   packages/sdk/package-lock.json,apps/api manifests, kept in sync
#   apps/api/package-lock.json

# ────── Rust / Soroban ──────
target/

# ────── Python ──────
__pycache__/
*.pyc
# Soroban snapshot files written by failing `Env::default()` tests
**/test_snapshots/
# Cargo.lock IS committed for the Soroban workspace (deterministic CI via
# `--locked`); see stellar-contracts/BUILD_ENV_NOTES.md.
**/*.rs.bk
*.wasm
.soroban/

# ────── Solidity / Hardhat ──────
artifacts/
cache/
typechain-types/
.openzeppelin/

# ────── Environment / Secrets ──────
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ────── Logs / OS ──────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ────── Test / Coverage ──────
coverage/
.nyc_output/
lcov.info

# ────── Docker / K8s ──────
infra/.volumes/
infra/data/
*.pid

# ────── DB dumps ──────
*.sql.gz
*.dump
.vercel
# NOTE: environment files are handled above (`.env`, `.env.*`, with
# `!.env.example`). Do not add a blanket `.env*` rule here — it would
# re-ignore the committed `*.env.example` templates.
