# ────── Node / JS / TS ──────
node_modules/
dist/
build/
.next/
.turbo/
out/
coverage/
*.tsbuildinfo
.pnpm-store/

# Lockfile policy: commit lockfiles for all packages with installable
# dependencies. The evm-contracts lockfile is required by the CI job
# (`npm ci` + setup-node cache-dependency-path); the `!sdk/package-lock.json`
# negation must come AFTER the `sdk/package-lock.json` ignore rule for the
# re-include to take effect (later .gitignore rules override earlier ones).
sdk/package-lock.json
!sdk/package-lock.json

# ────── Rust / Soroban ──────
target/

# ────── Python ──────
__pycache__/
*.pyc
# Soroban snapshot files written by failing `Env::default()` tests
**/test_snapshots/
# Cargo.lock IS committed for the Soroban workspace (deterministic CI via
# `--locked`); see stellar-contracts/BUILD_ENV_NOTES.md.
**/*.rs.bk
*.wasm
.soroban/

# ────── Solidity / Hardhat ──────
artifacts/
cache/
typechain-types/
.openzeppelin/

# ────── Environment / Secrets ──────
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ────── Logs / OS ──────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ────── Test / Coverage ──────
coverage/
.nyc_output/
lcov.info

# ────── Docker / K8s ──────
infra/.volumes/
infra/data/
*.pid

