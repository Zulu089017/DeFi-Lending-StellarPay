# ── Stellar ────────────────────────────────────────────────────────────────
# Soroban RPC (NOT Horizon). Events are read with getEvents.
SOROBAN_RPC=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Comma-separated contract ids whose events are indexed.
# Source of truth: packages/sdk/src/manifest.json
STELLAR_EVENT_CONTRACTS=CBNG3R6J2S4ZP7OEKIOS2JRVOJWG6YA56UR6N4Z4ZWIOH6LEX6R4NI2X,CAC5WYMZJIQKPFM6FRE6GHB37MQYGBBFKOVPJ7RMV46Z3II2VVBGS5FO
# Lending pool used for the X-4 on-chain view comparison.
STELLAR_POOL=CAC5WYMZJIQKPFM6FRE6GHB37MQYGBBFKOVPJ7RMV46Z3II2VVBGS5FO

# ── EVM ────────────────────────────────────────────────────────────────────
ETHEREUM_RPC=https://eth.llamarpc.com
ETHEREUM_BRIDGE=0x0000000000000000000000000000000000000000
POLYGON_BRIDGE=0x0000000000000000000000000000000000000000

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://spg:spg@localhost:5432/indexer

# ── Reconciliation ─────────────────────────────────────────────────────────
# Any funded testnet account, used only as the simulateTransaction source.
# Unset => X-1 and X-4 are skipped and reported as such.
RECONCILE_SOURCE_ACCOUNT=
# asset=contractId pairs for wrapped_asset.total_supply()
RECONCILE_WRAPPED_ASSETS=wETH=CAII636MSZW643AQVYNVATNDQSSEXWDWNYKZA2J7CFYHKTCQ7IDPIGWL,wUSDC=CCVDMRJYATZE6Y4C74PA4UZREV3TWASUL34XKYJ2RJB226ZZOJYAK67M
# Optional: compare API totals instead of DB totals for X-4.
API_URL=
RECONCILE_INTERVAL_MS=300000
# Unreleased unwraps older than this are reported by X-3.
RECONCILE_STALE_MS=1800000
# Optional JSON webhook for mismatch alerts.
RECONCILE_ALERT_WEBHOOK=

# ── Loop / HTTP ────────────────────────────────────────────────────────────
POLL_INTERVAL_MS=4000
PORT=4200
