generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cursor {
  chain       String   @id
  block       BigInt   @default(0)
  pagingToken String?
  updatedAt   DateTime @updatedAt
}

model SourceEvent {
  id           String   @id @default(cuid())
  chain        String
  txHash       String
  logIndex     Int
  blockNumber  BigInt
  sender       String
  token        String
  amount       BigInt
  stellarDest  String
  salt         String
  nonce        BigInt
  createdAt    DateTime @default(now())

  @@unique([chain, txHash, logIndex])
  @@index([chain, blockNumber])
}

model MintRequest {
  id              String   @id @default(cuid())
  chain           String
  sourceTx        String
  sourceLogIndex  Int
  sourceAddress   String
  amount          BigInt
  to              String
  salt            String
  status          String   @default("pending") // pending | minted | failed
  stellarTxHash   String?
  attempts        Int      @default(0)
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sourceTx, sourceLogIndex])
  @@index([status])
}

model UnwrapEvent {
  id             String   @id @default(cuid())
  chain          String
  // A single Stellar transaction may contain several `unwrap` operations,
  // each with its own nonce. Uniqueness must therefore include the nonce,
  // otherwise one unwrap would be collapsed and never released (X-3).
  txHash         String
  ledger         BigInt   @default(0)
  user           String
  amount         BigInt
  chainId        Int      @default(0)
  sourceChain    String
  sourceAddr     String
  nonce          String
  recipient      String?
  // pending | released | failed
  status         String   @default("pending")
  released       Boolean  @default(false)
  releaseTxHash  String?
  releaseAttempts Int     @default(0)
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([txHash, nonce])
  @@index([status])
}

model Attestation {
  id          String   @id @default(cuid())
  sourceTx    String
  salt        String
  payload     String
  signature   String
  signer      String
  createdAt   DateTime @default(now())
}
