# ── Source chain RPCs ─────────────────────────────────────────────────────
ETHEREUM_RPC=https://eth.llamarpc.com
POLYGON_RPC=https://polygon-rpc.com
SOLANA_RPC=https://api.mainnet-beta.solana.com

# ── EVM bridge addresses ──────────────────────────────────────────────────
ETHEREUM_BRIDGE=0x0000000000000000000000000000000000000000
POLYGON_BRIDGE=0x0000000000000000000000000000000000000000

# ── Stellar ───────────────────────────────────────────────────────────────
# Horizon endpoint (used to submit `wrap` transactions).
STELLAR_RPC=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_CONTROLLER=CDEVH2BOD4SMPNEORPO33A47PWN6A2IBAUETSF6U4XJ6FZ7IMMVMYZUI
# Source of truth: packages/sdk/src/manifest.json (regenerated by contracts/scripts/deploy-testnet.sh)
RELAYER_SECRET=S...  # Stellar secret key of the bridge relayer

# Soroban RPC endpoint used to read `unwrap` contract events. Horizon cannot
# serve contract events, so leaving this unset disables the unwrap watcher.
STELLAR_SOROBAN_RPC=https://soroban-testnet.stellar.org
# Optional: first ledger to scan on a cold start (defaults to the oldest
# ledger the RPC still retains).
# STELLAR_SOROBAN_START_LEDGER=123456

# ── Attester quorum ───────────────────────────────────────────────────────
# 32-byte ed25519 SECRET keys (the same curve Soroban uses natively), hex-encoded
# (64 hex chars per key, with the `0x` prefix). Each key must match the
# corresponding ed25519 PUBLIC key registered as `Bridge` in the on-chain
# `lending_controller` (DataKey::Bridge: BytesN<32>).
#
# Provide keys via EITHER `ATTESTER_KEYS` (comma-separated) OR
# `ATTESTER_KEYS_FILE` (path to a mounted secret file, newline- or
# comma-separated). Prefer the file form: it is injected by a secrets manager
# (K8s Secret / Docker secret / Vault agent / Doppler) so keys never sit in a
# plaintext env var. When both are set, `ATTESTER_KEYS_FILE` wins.
ATTESTER_KEYS=0x..,0x..,0x..
# ATTESTER_KEYS_FILE=/run/secrets/attester_keys
ATTESTER_THRESHOLD=2

# ── EVM release path (unwrap → Bridge.release) ────────────────────────────
# secp256k1 attester keys (EIP-712 `Release` signatures). These must be the
# same addresses registered via `Bridge.setAttesters` on the source chain.
# Independently of the ed25519 keys above. Prefer the mounted-file form.
EVM_ATTESTER_KEYS=0x..,0x..,0x..
# EVM_ATTESTER_KEYS_FILE=/run/secrets/evm_attester_keys
EVM_ATTESTER_THRESHOLD=2
# Canonical ERC-20 released on each chain. A chain with no token configured is
# skipped (its unwraps stay pending) rather than advertised as supported.
# ETHEREUM_RELEASE_TOKEN=0x...
# POLYGON_RELEASE_TOKEN=0x...
# EVM tx submitter keys (the account that pays gas for `release`).
# ETHEREUM_RELAYER_PK=0x...
# POLYGON_RELAYER_PK=0x...
# Confirmations required before an unwrap is marked released.
EVM_RELEASE_CONFIRMATIONS=2
EVM_RELEASE_GAS_LIMIT=300000
MAX_RELEASE_ATTEMPTS=10

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://spg:spg@localhost:5432/bridge

# ── Misc ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
POLL_INTERVAL_MS=4000
PORT=4100
HOST=0.0.0.0
