// The API uses the SAME database as the indexer; this schema is a read-only
// view over those tables. We point Prisma at the same DATABASE_URL and
// generate the client. We do not own these tables — they are managed by
// the indexer's migrations.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Mirrors services/indexer/prisma/schema.prisma. A Stellar transaction can
// contain more than one wrap/unwrap, so the natural key includes the nonce;
// keying by txHash alone dropped every event after the first in a tx.
model WrapEvent {
  id          String   @id
  txHash      String
  ledger      BigInt
  chainId     Int
  sourceAddr  String
  to          String
  amount      BigInt
  salt        String
  nonce       BigInt   @default(0)
  createdAt   DateTime

  @@unique([txHash, nonce])
}

model UnwrapEvent {
  id          String   @id
  txHash      String
  ledger      BigInt
  user        String
  amount      BigInt
  chainId     Int
  sourceAddr  String
  nonce       String
  released    Boolean
  // Back-side release outcome. These come from the EVM `Bridge.release`
  // pipeline (edge of #71 / `services/payment`), so they are `String?` /
  // absent on rows the unwrap watcher recorded and no relayer has touched.
  destination String?
  releaseTxHash String?
  releaseAttempts Int     @default(0)
  lastError     String?
  status        String    @default("pending") // pending | released | failed
  createdAt     DateTime

  @@unique([txHash, nonce])
}

model LendingEvent {
  id        String   @id
  txHash    String
  logIndex  Int
  type      String
  user      String
  asset     String
  amount    BigInt
  createdAt DateTime

  @@unique([txHash, logIndex])
}

model BridgeEvent {
  id        String   @id
  chain     String
  txHash    String
  logIndex  Int
  type      String
  sender    String
  token     String
  amount    BigInt
  stellarDest String?
  salt      String?
  stellarTxHash String?
  nonce     String?
  createdAt DateTime

  @@unique([chain, txHash, logIndex])
}
